# Copy to `.env` and adjust. Defaults below come from the table in Configuration.md.
# Never commit the real `.env`. Next.js does not load the root `.env`: app-only variables
# (secrets, SMTP URL, allowed origins) belong in `packages/app/.env.local`.
# Variables commented out are unset by default.

# --- Database ---
EASYRMS_DATABASE_URL=postgres://easyrms:easyrms@localhost:5433/easyrms
EASYRMS_DB_POOL_MIN=2
EASYRMS_DB_POOL_MAX=10
# Set to "true" to log SQL.
EASYRMS_DB_DEBUG=false

# --- HTTP / CSRF ---
# "true" or "false". Unset means false in development and tests; REQUIRED in production.
# "true" = a reverse proxy in front of the app overwrites x-forwarded-host / x-forwarded-for.
# EASYRMS_TRUST_PROXY=false
# Comma-separated extra origins (https://host[:port]) accepted by the CSRF check.
# EASYRMS_ALLOWED_ORIGINS=

# --- Mail ---
# "log" (default, delivers nothing) or "smtp".
EASYRMS_MAIL_TRANSPORT=log
# Required when the transport is smtp. Contains credentials.
# EASYRMS_SMTP_URL=smtps://user:password@smtp.example.pl:465
# Required when the transport is smtp: shared sender address.
# EASYRMS_MAIL_FROM=

# --- Orders ---
# Only "fake" exists today; it is rejected in production, where this variable is required.
EASYRMS_ORDER_SOURCE=fake

# --- Sessions (required outside development; at least 32 bytes each, different values) ---
# Generate with: openssl rand -hex 32
# EASYRMS_GUEST_SESSION_SECRET=
# EASYRMS_AGENT_SESSION_SECRET=

# --- Business rules ---
# Refund approval limit in PLN (2000,50 or 2000.50); above it MANAGE_RULES is needed.
EASYRMS_REFUND_APPROVAL_LIMIT=2000
# "on" or "off": rules recommendations box on the decision card.
EASYRMS_RULES_RECOMMENDATIONS=off
# Hours an agent invite granting MANAGE_RULES stays valid (0.25 to 72).
EASYRMS_MANAGER_INVITE_TTL_HOURS=8
# Days after delivery a line can be returned (clamped to 14-365).
EASYRMS_RETURN_WINDOW_DAYS=30
# Days after delivery to report transport damage or a missing item (1-30, default 14).
EASYRMS_TRANSPORT_WINDOW_DAYS=14
# Flat return shipping fee in PLN, deducted from refunds for parcel_locker and courier.
EASYRMS_RETURN_SHIPPING_FEE=0
