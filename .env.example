# Copy to `.env` and adjust. Consumed by @easyrms/core (app runtime) and the
# MikroORM CLI (@easyrms/db). Never commit the real `.env`.

# --- App ---
NODE_ENV=development
APP_NAME=EasyRms
LOG_LEVEL=info

# --- Database ---
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgres://easyrms:easyrms@127.0.0.1:5432/easyrms
# ... or the discrete DB_* vars below. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=easyrms
DB_USER=easyrms
DB_PASSWORD=easyrms

# --- Connection pool ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Set to "true" to log SQL.
DB_DEBUG=false
