# Copy to `.env` and adjust. Consumed by @easyrms/core (app runtime) and the
# MikroORM CLI (@easyrms/db). Never commit the real `.env`.

# --- App ---
NODE_ENV=development
APP_NAME=EasyRms
LOG_LEVEL=info

# --- Database ---
# Either set DATABASE_URL (takes precedence) ...
# DATABASE_URL=postgres://easyrms:easyrms@127.0.0.1:5432/easyrms
# ... or the discrete DB_* vars below. Defaults match docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=easyrms
DB_USER=easyrms
DB_PASSWORD=easyrms

# --- Connection pool ---
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Set to "true" to log SQL.
DB_DEBUG=false

# --- HTTP ---
# Mutating requests (POST/PUT/PATCH/DELETE) are rejected with 403 `csrf_rejected` when the `Origin` host differs
# from the host the server sees. If you open the dev app through a proxy, tunnel or port-forward that rewrites `Host`
# (and sets `x-forwarded-host`), set this to "true". Default: false in development; required in production.
EASYRMS_TRUST_PROXY=true
# Comma-separated extra origins accepted by the CSRF check, for a public host that neither `Host` nor
# `x-forwarded-host` reveals (chained proxies, e.g. a cloud sandbox URL in front of the dev server).
# EASYRMS_ALLOWED_ORIGINS=https://my-app.example.com
