{
  "name": "easyrms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @easyrms/app --",
    "build": "npm run build -w @easyrms/app",
    "start": "npm run start -w @easyrms/app --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:migrate": "npm run db:migrate -w @easyrms/db",
    "db:migration:create": "npm run db:migration:create -w @easyrms/db",
    "audit": "node scripts/audit.mjs"
  }
}
